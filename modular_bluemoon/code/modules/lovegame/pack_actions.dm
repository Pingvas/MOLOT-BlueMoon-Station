// Action Cards - Commands and activities to perform

/datum/love_card/actions
	name = "Action Card"
	desc = "A card with an action to perform"
	icon = 'icons/obj/lovecard/pack_1.dmi'
	icon_state = "deystvie"

/datum/love_card/actions/action_1
	name = "Give a massage"
	desc = "Give the person on your left a shoulder massage for 30 seconds."

/datum/love_card/actions/action_2
	name = "Tell a compliment"
	desc = "Tell the most sincere compliment you can to the person on your right."

/datum/love_card/actions/action_3
	name = "Dance together"
	desc = "Dance with the person across from you for 30 seconds."

/datum/love_card/actions/action_4
	name = "Funny voice"
	desc = "Speak in a funny voice for the rest of the round."

/datum/love_card/actions/action_5
	name = "Spin around"
	desc = "Spin around three times as fast as you can."

/datum/love_card/actions/action_6
	name = "Hold hands"
	desc = "Hold hands with the person next to you for one minute."

/datum/love_card/actions/action_7
	name = "Tell a joke"
	desc = "Tell the funniest joke you know to everyone."

/datum/love_card/actions/action_8
	name = "Act out a scene"
	desc = "Act out a dramatic scene with someone of your choice for 30 seconds."

/datum/love_card/actions/action_9
	name = "Sing a song"
	desc = "Sing any song you like, it doesn't have to be in tune."

/datum/love_card/actions/action_10
	name = "Do impressions"
	desc = "Do your best impression of another person here for 30 seconds."

/datum/love_card/actions/action_11
	name = "Give a hug"
	desc = "Give a warm hug to whoever wants one."

/datum/love_card/actions/action_12
	name = "Make eye contact"
	desc = "Make intense eye contact with someone for 30 seconds without speaking."
